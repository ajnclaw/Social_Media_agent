# Virtual environment
.venv/

# Python bytecode / cache
__pycache__/
*.pyc

# pytest cache
.pytest_cache/

# Agent's file-tool sandbox (write_file/edit_file/run_command all
# resolve here now, not the source tree)
sandbox/

# Agent runtime data (regenerated automatically, not source)
memory.json
memory.txt

# Local logs (once we add structured logging)
logs/

# Local secrets -- never commit
.env

# Personal voice reference clip -- not needed by the image server this
# repo also gets cloned for, and shouldn't sit in a public repo
assets/
